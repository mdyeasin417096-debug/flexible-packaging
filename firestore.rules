rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read, create, update: if signedIn() && (request.auth.uid == uid || admin());
      allow delete: if admin();
      match /savedJobs/{jobId} { allow read, write: if signedIn() && request.auth.uid == uid; }
      match /devices/{deviceId} { allow read, write: if signedIn() && request.auth.uid == uid; }
    }

    match /jobs/{jobId} {
      allow read: if resource.data.active == true || admin();
      allow create, update, delete: if admin();
    }

    match /applications/{applicationId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow update: if admin();
      allow delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /news/{newsId} { allow read: if true; allow write: if admin(); }
    match /notifications/{notificationId} { allow read: if signedIn(); allow write: if admin(); }
    match /technical_content/{contentId} { allow read: if true; allow write: if admin(); }
  }
}
